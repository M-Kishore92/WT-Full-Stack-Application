# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_db?schema=public"

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Security
JWT_SECRET="super-secret-jwt-key-for-development-32-chars-min"
JWT_EXPIRES_IN="24h"
